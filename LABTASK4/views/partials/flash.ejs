<% if (success_msg && success_msg.length > 0) { %>
    <div style="margin: 16px auto; max-width: 1100px; padding: 12px 16px; border-radius: 10px; background: #e7f7ed; color: #155724; border: 1px solid #b7e1c1;">
        <%= success_msg[0] %>
    </div>
<% } %>

<% if (error_msg && error_msg.length > 0) { %>
    <div style="margin: 16px auto; max-width: 1100px; padding: 12px 16px; border-radius: 10px; background: #fdecea; color: #8a1f11; border: 1px solid #f5c2c7;">
        <%= error_msg[0] %>
    </div>
<% } %>