    <a href="/products?category=Jewelry">Jewelry</a>
    <a href="/products?category=Crafts">Crafts</a>
</div>


<hr>
    <h1>Products</h1>
    <form action="/products" method="GET">

    <input
        type="text"
        name="search"
        placeholder="Search Product"
        value="<%= search %>"
    >

    <select name="category">

       <option value="">All Categories</option>

<option value="Fashion">Fashion</option>

<option value="Jewelry">Jewelry</option>

<option value="Home Decor">Home Decor</option>

<option value="Gifts">Gifts</option>

<option value="Crafts">Crafts</option>

    </select>

    <input
        type="number"
        name="minPrice"
        placeholder="Min Price"
        value="<%= minPrice %>"
    >

    <input
        type="number"
        name="maxPrice"
        placeholder="Max Price"
        value="<%= maxPrice %>"
    >

    <button type="submit">

        Filter

    </button>

</form>
    <div class="products-container">

        <% products.forEach(product => { %>

            <div class="card">

    <img 
    src="/uploads/<%= product.image %>"
>

    <div class="card-content">

        <h2><%= product.name %></h2>

        <p class="category-text">
            <%= product.category %>
        </p>

        <div class="rating-stars">

            <% for(let i = 1; i <= 5; i++){ %>

                <% if(i <= product.rating){ %>

                    <img 
                        src="/images/star.png"
                        class="star-icon"
                    >

                <% } else { %>

                    <img 
                        src="/images/star2.png"
                        class="star-icon"
                    >

                <% } %>

            <% } %>

            <span class="rating-number">
                (<%= product.rating %>)
            </span>

        </div>

        <div class="price-stock">

            <p class="price">
                $<%= product.price %>
            </p>

            <p class="stock">

                <% if(product.stock == 0){ %>

                    Out of stock

                <% } else if(product.stock <= 3){ %>

                    Only <%= product.stock %> left

                <% } else { %>

                    In stock <%= product.stock %> left

                <% } %>

            </p>

        </div>

        <% if (product.stock > 0) { %>
            <form action="/cart/add/<%= product._id %>" method="POST" class="card-cart-form js-add-to-cart-form" data-product-name="<%= product.name %>">
                <div class="qty-row">
                    <label for="qty-<%= product._id %>" class="qty-label">Qty</label>
                    <input
                        id="qty-<%= product._id %>"
                        type="number"
                        name="quantity"
                        min="1"
                        max="<%= product.stock %>"
                        value="1"
                        required
                        class="qty-input"
                    >
                </div>
                <button type="submit" class="card-cart-btn">Add to Cart</button>
                <p class="cart-inline-message" aria-live="polite"></p>
            </form>
        <% } %>

    </div>

</div>

        <% }) %>

    </div>



    <div class="pagination">

    <% if(currentPage > 1){ %>

        <a href="/products?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">
            Previous
        </a>

    <% } %>

    <% for(let i = 1; i <= totalPages; i++){ %>

        <a href="/products?page=<%= i %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">

            <%= i %>

        </a>

    <% } %>

    <% if(currentPage < totalPages){ %>

        <a href="/products?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">
            Next
        </a>

    <% } %>

</div>





