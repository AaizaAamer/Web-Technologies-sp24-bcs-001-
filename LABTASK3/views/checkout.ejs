<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .checkout-page {
            min-height: 100vh;
            padding: 28px 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at top left, rgba(255, 181, 120, 0.2), transparent 36%),
                linear-gradient(135deg, #f8f5ef 0%, #fffdf9 100%);
        }

        .checkout-card {
            width: min(100%, 760px);
            background: #ffffff;
            border: 1px solid rgba(17, 24, 39, 0.08);
            border-radius: 22px;
            padding: 32px;
            box-shadow: 0 20px 42px rgba(17, 24, 39, 0.12);
        }

        .checkout-title {
            margin: 0 0 18px;
            font-size: 34px;
            color: #111827;
        }

        .checkout-note {
            margin: 0 0 14px;
            color: #374151;
            line-height: 1.6;
            font-size: 16px;
        }

        .session-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 8px 0 20px;
            padding: 10px 14px;
            border-radius: 999px;
            background: #fff7ed;
            color: #9a3412;
            font-weight: 700;
            border: 1px solid #fed7aa;
        }

        .checkout-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .checkout-link {
            text-decoration: none;
            border-radius: 12px;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 700;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .checkout-link.primary {
            color: #ffffff;
            background: linear-gradient(135deg, #f97316, #ea580c);
        }

        .checkout-link.secondary {
            color: #111827;
            border: 1px solid #d1d5db;
            background: #ffffff;
        }

        .checkout-link:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(17, 24, 39, 0.14);
        }

        @media (max-width: 768px) {
            .checkout-card {
                padding: 24px;
                border-radius: 18px;
            }

            .checkout-title {
                font-size: 28px;
            }
        }

        @media (max-width: 480px) {
            .checkout-page {
                padding: 16px;
            }

            .checkout-card {
                padding: 18px;
                border-radius: 14px;
            }

            .checkout-title {
                font-size: 24px;
            }

            .checkout-link {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body class="checkout-page">
    <main class="checkout-card">
        <%- include("./partials/flash") %>

        <h1 class="checkout-title">Checkout</h1>

        <p class="checkout-note">This page is protected. Only logged-in users can access checkout.</p>

        <p class="session-pill">Signed in as: <%= user ? user.name : "Guest" %></p>

        <div class="checkout-actions">
            <a href="/products" class="checkout-link secondary">Back to Products</a>
            <a href="/logout" class="checkout-link primary">Logout</a>
        </div>
    </main>
</body>
</html>