<body style="font-family: Arial, Helvetica, sans-serif;">
    <%- include("./partials/flash") %>
    <div class="navbar">
        <div class="LOGO">
        <img src="/images/download.png" width="100px">
        </div>


        <div class="Search">
            <div class="Search input">
            <input type="text" placeholder="Search for anything" style="padding-left:20px;">
            </div>
            <div class="Search-icon">
                <img src="/images/search (1).png">
            </div>
        </div>

           <div class="Sign-in">
               <a href="/checkout" class="sign-in-btn">Checkout</a>
               <% if (user) { %>
                   <a href="/profile" class="sign-in-btn">My Profile</a>
                   <a href="/logout" class="sign-in-btn">Logout</a>
               <% } else { %>
                   <a href="/login" class="sign-in-btn">Login</a>
                   <a href="/register" class="sign-in-btn">Register</a>
               <% } %>
           </div>
        <div class="icons">
            <div class="heart-icon">
                <img src="/images/favorites.png" width="20px">
            </div>
            <div class="gift-icon">
                <img src="/images/gift.png" width="20px">
            </div>
            <div class="parcel-icon">
                <img src="/images/parcel.png" width="20px">
            </div>
        </div>
    </div>
    <!--desktop subnavbar-->
<div class="subnavbar">
    <a href="/products">All Products</a>
    <a href="/products?category=Gifts">Gifts</a>
    <a href="/products?category=New Arrivals">New Arrivals</a>
    <a href="/products?category=Home Decor">Home Decor</a>
    <a href="/products?category=Fashion">Fashion</a>
    <a href="/products?category=Jewelry">Jewelry</a>
    <a href="/products?category=Crafts">Crafts</a>
</div>

<div class="mobile-navbar">

<div class="mobile-top">
    <div class="LOGO">
    <img src="/images/download.png" width="80px">
    </div>
    
    <div class="mobile-icons">
         <div class="Sign-in">
