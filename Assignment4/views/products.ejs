</div>
        <div class="LOGO">
        <img src="/images/download.png" width="100px">
        </div>


        <div class="Search">
            <div class="Search input">
            <input type="text" placeholder="Search for anything" style="padding-left:20px;">
            </div>
            <div class="Search-icon">
                <img src="/images/search (1).png">
            </div>
        </div>

        <div class="Sign-in">
             <a href="#" class="sign-in-btn">Sign In</a>
        </div>
        <div class="icons">
            <div class="heart-icon">
                <img src="/images/favorites.png" width="20px">
            </div>
            <div class="gift-icon">
                <img src="/images/gift.png" width="20px">
            </div>
            <div class="parcel-icon">
                <img src="/images/parcel.png" width="20px">
            </div>
        </div>
    </div>
    <!--desktop subnavbar-->
<div class="subnavbar">
    <a href="/products">All Products</a>
    <a href="/products?category=Gifts">Gifts</a>
    <a href="/products?category=New Arrivals">New Arrivals</a>
    <a href="/products?category=Home Decor">Home Decor</a>
    <a href="/products?category=Fashion">Fashion</a>
    <a href="/products?category=Jewelry">Jewelry</a>
    <a href="/products?category=Crafts">Crafts</a>
</div>


<hr>
    <h1>Products</h1>
    <form action="/products" method="GET">

    <input
        type="text"
        name="search"
        placeholder="Search Product"
        value="<%= search %>"
    >

    <select name="category">

       <option value="">All Categories</option>

<option value="Fashion">Fashion</option>

<option value="Jewelry">Jewelry</option>

<option value="Home Decor">Home Decor</option>

<option value="Gifts">Gifts</option>

<option value="Crafts">Crafts</option>

    </select>

    <input
        type="number"
        name="minPrice"
        placeholder="Min Price"
        value="<%= minPrice %>"
    >

    <input
        type="number"
        name="maxPrice"
        placeholder="Max Price"
        value="<%= maxPrice %>"
    >

    <button type="submit">

        Filter

    </button>

</form>
    <div class="products-container">

        <% products.forEach(product => { %>

            <div class="card">

    <img 
    src="/uploads/<%= product.image %>"
>

    <div class="card-content">

        <h2><%= product.name %></h2>

        <p class="category-text">
            <%= product.category %>
        </p>

        <div class="rating-stars">

            <% for(let i = 1; i <= 5; i++){ %>

                <% if(i <= product.rating){ %>

                    <img 
                        src="/images/star.png"
                        class="star-icon"
                    >

                <% } else { %>

                    <img 
                        src="/images/star2.png"
                        class="star-icon"
                    >

                <% } %>

            <% } %>

            <span class="rating-number">
                (<%= product.rating %>)
            </span>

        </div>

        <div class="price-stock">

            <p class="price">
                $<%= product.price %>
            </p>

            <p class="stock">

                <% if(product.stock == 0){ %>

                    Out of stock

                <% } else if(product.stock <= 3){ %>

                    Only <%= product.stock %> left

                <% } else { %>

                    In stock <%= product.stock %> left

                <% } %>

            </p>

        </div>

    </div>

</div>

        <% }) %>

    </div>



    <div class="pagination">

    <% if(currentPage > 1){ %>

        <a href="/products?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">
            Previous
        </a>

    <% } %>

    <% for(let i = 1; i <= totalPages; i++){ %>

        <a href="/products?page=<%= i %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">

            <%= i %>

        </a>

    <% } %>

    <% if(currentPage < totalPages){ %>

        <a href="/products?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">
            Next
        </a>

    <% } %>

</div>





