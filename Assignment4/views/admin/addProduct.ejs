<!DOCTYPE html>
<html lang="en">

<head>
    <title>Add Product</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<%- include("./partials/adminSidebar") %>

<div class="form-container">

<form
action="/admin/add"
method="POST"
enctype="multipart/form-data"
class="product-form">

    <h1>Add Product</h1>

    <input
    type="text"
    name="name"
    placeholder="Product Name"
    required>

    <input
    type="number"
    name="price"
    placeholder="Price"
    min="0"
    required>

    <input
    type="number"
    name="stock"
    placeholder="Stock"
    min="0"
    required>

    <input
    type="number"
    name="rating"
    placeholder="Rating"
    min="0"
    max="5"
    step="0.1"
    required>

    <select
    name="category"
    required>

        <option value="">
            Select Category
        </option>

        <option value="Fashion">
            Fashion
        </option>

        <option value="Jewelry">
            Jewelry
        </option>

        <option value="Home Decor">
            Home Decor
        </option>

        <option value="Gifts">
            Gifts
        </option>

        <option value="Crafts">
            Crafts
        </option>

        <option value="Party">
            Party
        </option>

        <option value="Pets">
            Pets
        </option>

        <option value="Toys">
            Toys
        </option>

    </select>

    <input
    type="file"
    name="image"
    required>

    <button type="submit">
        Add Product
    </button>

</form>
</div>

</body>
</html>