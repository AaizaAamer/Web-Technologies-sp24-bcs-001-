<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="admin-container">

    <%- include("adminSidebar") %>

    <div class="admin-content">

        <h1>Admin Dashboard</h1>

        <table border="1">

            <tr>

                <th>Image</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Category</th>
                <th>Actions</th>

            </tr>

            <% products.forEach(product => { %>

            <tr>

                <td>
                    <img
                    src="<%= product.image %>"
                    width="100">
                </td>

                <td><%= product.name %></td>

                <td><%= product.price %></td>

                <td><%= product.stock %></td>

                <td><%= product.category %></td>

                <td>

                    <a href="/admin/edit/<%= product._id %>">
                        Edit
                    </a>

                    <form
                    action="/admin/delete/<%= product._id %>"
                    method="POST">

                    <button
                    onclick="return confirm('Are you sure?')">

                    Delete

                    </button>

                    </form>

                </td>

            </tr>

            <% }) %>

        </table>

    </div>

</div>

</body>
</html>