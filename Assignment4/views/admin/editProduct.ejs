<!DOCTYPE html>
<html lang="en">

<head>
    <title>Edit Product</title>
</head>

<body>

<h1>Edit Product</h1>

<form
action="/admin/edit/<%= product._id %>"
method="POST"
enctype="multipart/form-data">

<input
type="text"
name="name"
value="<%= product.name %>">

<input
type="number"
name="price"
value="<%= product.price %>">

<input
type="number"
name="stock"
value="<%= product.stock %>">

<input
type="text"
name="category"
value="<%= product.category %>">

<input
type="file"
name="image">

<button type="submit">
Update Product
</button>

</form>

</body>
</html>